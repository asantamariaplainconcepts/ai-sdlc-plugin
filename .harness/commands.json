{
  // This repository declares its own gates: the PoC verifies itself as its first subject.
  // Read as JSONC (comments and trailing commas allowed), bounded before parsing, and never
  // executed by its reader.
  //
  //   "gate"  whether its exit code counts toward whether this worktree can be merged. Absent
  //           means no — a claim nobody made is not one to infer. Only a one-shot may carry it.
  "commands": [
    {
      "key": "gate",
      "name": "Gate",
      "run": "./gate.sh",
      "gate": true
    },
    {
      // How this checkout's own change is validated, for the Proposal step to read.
      // No "gate": it is a thing to read, not a claim about the branch.
      "key": "openspec-validate",
      "name": "OpenSpec validate",
      "run": "openspec validate --all --strict"
    }
  ]
}
